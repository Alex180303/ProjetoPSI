<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".PedidosActivity">


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/actionBarSize"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="Todos"
                android:textSize="10sp"
                android:maxLines="1"
                android:textStyle="bold"
                android:textColor="@color/azul_escuro"
                app:strokeColor="@color/azul_escuro"
                app:cornerRadius="16dp"
                app:strokeWidth="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Pendentes"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/azul_escuro"
                    app:strokeColor="@color/azul_escuro"
                    app:cornerRadius="16dp"
                    app:strokeWidth="2dp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Aprovado"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/azul_escuro"
                    app:strokeColor="@color/azul_escuro"
                    app:cornerRadius="16dp"
                    app:strokeWidth="2dp" />


                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:text="Rejeitado"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/azul_escuro"
                    app:strokeColor="@color/azul_escuro"
                    app:cornerRadius="16dp"
                    app:strokeWidth="2dp" />

            </LinearLayout>
        </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@color/azul"
                    android:text=""
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOME DO ANIMAL"
                        android:textColor="@color/azul_escuro"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA DE SUBMISSÃO"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Pendente"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="450dp"
                android:layout_gravity="end"
                android:orientation="vertical">


            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:text="Pedir Adoção"
                android:textSize="12sp"
                android:maxLines="1"
                android:textStyle="bold"
                android:textColor="@color/azul_escuro"
                app:strokeColor="@color/azul_escuro"
                app:cornerRadius="16dp"
                app:strokeWidth="2dp"
                android:onClick="onClickPedirAdocao"/>

        </LinearLayout>




        </LinearLayout>







    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.constraintlayout.widget.ConstraintLayout>